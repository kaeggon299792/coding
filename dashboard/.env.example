# ============================================================
# .env.example - 실제 값을 채운 뒤 파일명을 .env로 바꿔서 사용하세요.
# 이 파일 자체(.env.example)에는 실제 비밀값을 절대 넣지 마세요.
# .env는 반드시 .gitignore에 포함되어야 하며 git에 커밋하지 마세요.
# ============================================================

# ---- Flask 세션/보안 ----
# python -c "import secrets; print(secrets.token_hex(32))" 로 생성
FLASK_SECRET_KEY=
SESSION_LIFETIME_DAYS=7

# ---- 대시보드 자체 DB ----
DASHBOARD_DB_FILE=dashboard.db

# ---- 기존 뉴스/이메일 프로그램 DB (읽기 전용 연결만 사용) ----
# 예: /home/사용자명/casino_news_watch/news_history.db
NEWS_DB_FILE=
# 예: /home/사용자명/email_monitor/email_monitor.db
EMAIL_DB_FILE=

# ---- 텔레그램 (기존 casino_news_watch/email_monitor/datalab_capture와 동일한 봇) ----
# 대시보드는 getUpdates(수신)만 사용하며 sendMessage/sendPhoto(발송) 로직과 분리되어 있습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5402401368
TELEGRAM_POLL_INTERVAL_SECONDS=60
TELEGRAM_REQUEST_TIMEOUT_SECONDS=35
# 신규로 추가되는 "중요 공시 긴급 알림" 발송 스위치. 처음에는 반드시 true로 시작하세요.
TELEGRAM_ALERT_DRY_RUN=true

# ---- OpenAI (경영진 시사점 / 공시 분석 / 법률 분석 공통) ----
OPENAI_API_KEY=
OPENAI_INSIGHT_MODEL=
OPENAI_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
MAX_GPT_CALLS_PER_DAY=50
DAILY_OPENAI_BUDGET_USD=0.50

# ---- DART 공시통합정보 OpenAPI ----
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=
DART_SYNC_LOOKBACK_DAYS=3
# 쉼표로 구분, 비우면 기본 키워드 목록 사용
DART_IMPORTANT_KEYWORDS=

# ---- 국가법령정보센터 Open API ----
# https://open.law.go.kr 에서 무료 발급 (oc = 가입 시 이메일 아이디 부분)
LAW_API_OC=
LAW_API_KEY=

# ---- 로그 ----
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
