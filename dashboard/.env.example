# ============================================================
# .env.example - 실제 값을 채운 뒤 파일명을 .env로 바꿔서 사용하세요.
# 이 파일 자체(.env.example)에는 실제 비밀값을 절대 넣지 마세요.
# .env는 반드시 .gitignore에 포함되어야 하며 git에 커밋하지 마세요.
# ============================================================

# ---- Flask 세션/보안 ----
# python -c "import secrets; print(secrets.token_hex(32))" 로 생성
FLASK_SECRET_KEY=
DASHBOARD_PUBLIC_URL=https://www.casinoin.kr
TRUSTED_HOSTS=www.casinoin.kr,casinoin.kr,casino.shingoon.me,www.casino.shingoon.me,dashboard.shingoon.me
SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_SECURE=true

# ---- Google OAuth 2.0 / OpenID Connect ----
# Google Cloud Console의 웹 애플리케이션 사용자 인증 정보에 등록합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.casinoin.kr/auth/google/callback

# ---- 대시보드 자체 DB ----
DASHBOARD_DB_FILE=dashboard.db

# ---- 공문·자료관리 / 관리자 PC 동기화 ----
SYNC_API_TOKEN=
OFFICIAL_DOC_TEMP_DIR=data/official_doc_temp
OFFICIAL_DOC_MAX_UPLOAD_MB=50
OFFICIAL_DOC_TEMP_RETENTION_DAYS=3
SYNC_CLAIM_TIMEOUT_MINUTES=30

# ---- 기존 뉴스/이메일 프로그램 DB (읽기 전용 연결만 사용) ----
# 예: /home/사용자명/casino_news_watch/news_history.db
NEWS_DB_FILE=
# 예: /home/사용자명/email_monitor/email_monitor.db
EMAIL_DB_FILE=

# ---- 댓글 이메일 알림 (서버 측 SMTP 전용) ----
COMMENT_SMTP_HOST=
COMMENT_SMTP_PORT=587
COMMENT_SMTP_USERNAME=
COMMENT_SMTP_PASSWORD=
COMMENT_EMAIL_FROM=
COMMENT_SMTP_STARTTLS=true
COMMENT_SMTP_USE_SSL=false
COMMENT_SMTP_TIMEOUT_SECONDS=8

# ---- 텔레그램 (기존 casino_news_watch/email_monitor/datalab_capture와 동일한 봇) ----
# 대시보드는 getUpdates(수신)만 사용하며 sendMessage/sendPhoto(발송) 로직과 분리되어 있습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5402401368
TELEGRAM_POLL_INTERVAL_SECONDS=60
TELEGRAM_REQUEST_TIMEOUT_SECONDS=35
# 신규로 추가되는 "중요 공시 긴급 알림" 발송 스위치. 처음에는 반드시 true로 시작하세요.
TELEGRAM_ALERT_DRY_RUN=true

# ---- 회원 알림 전용 Telegram Bot (관리자 Bot과 별도) ----
TELEGRAM_MEMBER_BOT_TOKEN=
TELEGRAM_MEMBER_BOT_USERNAME=casinoin_assistant_bot
TELEGRAM_MEMBER_LINK_TTL_MINUTES=15

# ---- OpenAI (경영진 시사점 / 공시 분석 / 법률 분석 공통) ----
OPENAI_API_KEY=
OPENAI_INSIGHT_MODEL=
OPENAI_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
OPENAI_TRANSLATION_INPUT_COST_PER_1M=0.75
OPENAI_TRANSLATION_OUTPUT_COST_PER_1M=4.50
MAX_GPT_CALLS_PER_DAY=50
DAILY_OPENAI_BUDGET_USD=0.50
LOCALIZATION_TRANSLATION_BATCH_SIZE=40
LOCALIZATION_TRANSLATION_MAX_ITEMS_PER_RUN=1000
LOCALIZATION_TRANSLATION_MAX_CHARS_PER_BATCH=12000
LOCALIZATION_TRANSLATION_LANGUAGES=ja,yue-HK
CONTENT_TRANSLATION_BATCH_SIZE=20
CONTENT_TRANSLATION_MAX_ITEMS_PER_RUN=100
CONTENT_TRANSLATION_MAX_CHARS_PER_BATCH=24000
CONTENT_TRANSLATION_NEWS_DAYS=30
CONTENT_TRANSLATION_NEWS_SCAN_LIMIT=500
REMEMBER_LOGIN_DAYS=30
PROFILE_IMAGE_MAX_BYTES=3145728

# ---- DART 공시통합정보 OpenAPI ----
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=
DART_SYNC_LOOKBACK_DAYS=3
# corpCode.xml(전체 상장사 고유번호 zip)은 응답이 커서 더 긴 타임아웃이 필요할 수 있음
DART_CORP_CODE_TIMEOUT_SECONDS=60
# 쉼표로 구분, 비우면 기본 키워드 목록 사용
DART_IMPORTANT_KEYWORDS=

# ---- 국가법령정보센터 Open API ----
# https://open.law.go.kr 에서 "OPEN API 신청" 후 마이페이지에 표시되는 값을 그대로 사용
# (예: OC_XXXXXXXXXXXX 형태 - 이메일 아이디가 아니라 발급된 인증키 전체를 넣어야 함)
# 반드시 신청 화면에서 호출할 서버의 IP주소를 등록해야 인증이 통과됨(등록 안 하면
# "사용자 정보 검증에 실패하였습니다" 오류가 남)
LAW_API_OC=
LAW_API_KEY=
ASSEMBLY_API_KEY=
ASSEMBLY_ERA=제22대
ASSEMBLY_BILL_KEYWORDS=카지노,관광진흥법,복합리조트,사행산업,외국인전용카지노
ASSEMBLY_AI_MAX_PER_RUN=10
MARKET_DATA_API_KEY=
NPS_API_KEY=
NPS_REQUEST_TIMEOUT_SECONDS=30
TOSS_INVEST_CLIENT_ID=
TOSS_INVEST_CLIENT_SECRET=

# ---- 로그 ----
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---- PythonAnywhere administrator status card ----
PYTHONANYWHERE_USERNAME=
PYTHONANYWHERE_API_TOKEN=
PYTHONANYWHERE_DISK_QUOTA_GB=
PYTHONANYWHERE_STATUS_CACHE_SECONDS=300
PYTHONANYWHERE_API_TIMEOUT_SECONDS=8
PYTHONANYWHERE_DISK_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
GEMINI_NEWS_MAX_PER_RUN=30
GEMINI_INPUT_COST_PER_1M_USD=1.50
GEMINI_OUTPUT_COST_PER_1M_USD=9.00
GEMINI_SEARCH_COST_PER_1000_USD=14.00
GEMINI_USD_KRW_FALLBACK_RATE=1400
